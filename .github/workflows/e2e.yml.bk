# On-demand E2E — pick suite via inputs (tags)
name: E2E

on:
  workflow_dispatch:
    inputs:
      suite:
        description: 'Tag filter (smoke | sanity | regression | ui | api | all)'
        required: true
        default: 'smoke'
        type: choice
        options:
          - smoke
          - sanity
          - regression
          - ui
          - api
          - all
      test_env:
        description: 'Target environment'
        required: true
        default: 'staging'
        type: choice
        options:
          - staging
          - local

jobs:
  e2e:
    timeout-minutes: 60
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Run suite
        env:
          TEST_ENV: ${{ inputs.test_env }}
          CI: true
          # Optional URL overrides via repo/env secrets later:
          # FRONTEND_URL: ${{ vars.FRONTEND_URL }}
          # ORDER_URL: ${{ vars.ORDER_URL }}
          # INVENTORY_URL: ${{ vars.INVENTORY_URL }}
          # NOTIFICATION_URL: ${{ vars.NOTIFICATION_URL }}
        run: |
          if [ "${{ inputs.suite }}" = "all" ]; then
            npx playwright test
          else
            npx playwright test --grep "@${{ inputs.suite }}"
          fi

      - uses: actions/upload-artifact@v4
        if: ${{ !cancelled() }}
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 14
