# Copy to .env for local runs (gitignored)
# Loaded automatically by playwright.config.ts via dotenv
# URL vars are required — no defaults in code

TEST_ENV=staging

FRONTEND_URL=https://frontend-svc.test-suites-poc.work.gd
ORDER_URL=https://order-svc.test-suites-poc.work.gd
INVENTORY_URL=https://inventory-svc.test-suites-poc.work.gd
NOTIFICATION_URL=https://notification-svc.test-suites-poc.work.gd

# Local example:
# TEST_ENV=local
# FRONTEND_URL=http://localhost:5173
# ORDER_URL=http://localhost:3000
# INVENTORY_URL=http://localhost:3001
# NOTIFICATION_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# ReportPortal — agent enabled when RP_API_KEY is set (unless RP_ENABLED=false)
# ---------------------------------------------------------------------------
RP_ENABLED=true
RP_ENDPOINT=https://report-portal.test-suites-poc.work.gd/api/v2
RP_PROJECT=omni-suites
RP_LAUNCH=playwright-local
RP_DESCRIPTION=omni-suites Playwright run
RP_API_KEY=
